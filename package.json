{
	"name": "sveltekit-negotiate",
	"version": "0.2.0",
	"description": "Drop-in HTTP content negotiation for SvelteKit. Serve the same route as HTML, Markdown, JSON, XML or any format driven by the Accept header or a URL extension.",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && npm run prepack",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"prepack": "svelte-kit sync && svelte-package && publint",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run"
	},
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*",
		"README.md",
		"LICENSE"
	],
	"sideEffects": [
		"**/*.css"
	],
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js"
		}
	},
	"peerDependencies": {
		"@sveltejs/kit": "^2.0.0",
		"svelte": "^5.0.0"
	},
	"devDependencies": {
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/kit": "^2.57.0",
		"@sveltejs/package": "^2.5.7",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"prettier": "^3.8.1",
		"prettier-plugin-svelte": "^3.5.1",
		"publint": "^0.3.18",
		"svelte": "^5.55.2",
		"svelte-check": "^4.4.6",
		"typescript": "^6.0.2",
		"vite": "^8.0.7",
		"vitest": "^4.1.3"
	},
	"keywords": [
		"svelte",
		"sveltekit",
		"content-negotiation",
		"accept-header",
		"markdown",
		"json",
		"http"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/nathancahill/sveltekit-negotiate.git"
	},
	"bugs": {
		"url": "https://github.com/nathancahill/sveltekit-negotiate/issues"
	},
	"homepage": "https://github.com/nathancahill/sveltekit-negotiate#readme",
	"author": "Nathan Cahill",
	"license": "MIT"
}
